DATABASE_URL=postgres://user:pass@127.0.0.1:5432/billing
# Optional Supabase runtime URI; takes precedence over DATABASE_URL when set.
SUPABASE_CONNECT_URI=
# Compatibility alias for older deployment contracts.
SUPABASE_CONNECT_URL=
LISTEN_ADDR=:8081
INTERNAL_SERVICE_TOKEN=dev_token
EXPORTER_BASE_URL=http://127.0.0.1:9090

# OpenTelemetry OTLP Traces Ingestion (SIT / UAT / PROD Multi-Environment Routing)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://observability.svc.plus/ingest/otlp/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=billing-${RUNTIME_ENV:-prod}
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=${RUNTIME_ENV:-prod},service.version=latest"
